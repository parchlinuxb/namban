[Unit]
Description=Namban Local DNS-over-HTTPS Forwarder for %I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/namban/src/nambancore/doh_proxy.py %I 127.0.0.54 53
Restart=on-failure
RestartSec=2s
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
